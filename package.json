{
  "name": "marrok-content-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); try{fs.unlinkSync('server.js')}catch{}\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "hash-password": "node scripts/hash-password.mjs",
    "benchmark": "tsx scripts/benchmark-core-engines.ts",
    "video:studio": "node video-studio/studio/server.mjs",
    "video:new": "node video-studio/scripts/new-project.mjs",
    "video:audio": "node video-studio/engine/audio-vo.mjs",
    "video:render": "node video-studio/engine/render-video.mjs",
    "video:build": "node video-studio/engine/build-pipeline.mjs",
    "video:qa": "node video-studio/engine/qa-inspect.mjs",
    "video:lint": "node video-studio/scripts/lint-check.mjs"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@netlify/functions": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mp4-muxer": "^5.2.2",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "simple-icons": "^16.37.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
