# GEMINI_API_KEY: Primary server-side Gemini API key for /api/generate, /api/refine-slide, and /api/generate-image.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_BACKUP / GEMINI_API_KEY_2: Optional second Gemini API key from another Google account.
# Automatically used when the primary key hits 429 rate limits or quota exhaustion.
GEMINI_API_KEY_BACKUP=""

# GEMINI_API_KEYS: Optional comma-separated pool of additional Gemini API keys for automatic failover rotation.
GEMINI_API_KEYS=""

# FREE_BACKUP_AI_ENABLED: Enable zero-key Pollinations AI fallback (text + 9:16 flux images) before going offline (default: true).
FREE_BACKUP_AI_ENABLED="true"

# FREE_TEXT_BACKUP_MODELS: Comma-separated zero-key Pollinations OpenAI-compatible backup models.
FREE_TEXT_BACKUP_MODELS="openai,mistral,llama"

# APP_URL / ALLOWED_ORIGINS: Strict explicit CORS origin allowlist (never '*').
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="https://marrok-content.netlify.app,http://localhost:3000"

# SINGLE-USER SESSION AUTHENTICATION (REQUIRED FOR ALL /api/* IN PRODUCTION):
# Scope these strictly to Functions -> production context in Netlify UI (never VITE_*).
# Generate password hash interactively (masked, no shell history): npm run hash-password
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
SESSION_TTL_SECONDS="43200"

# API_SHARED_SECRET: Optional automation-only secret header (x-api-secret) for external cron calls.
API_SHARED_SECRET=""

# RATE_LIMIT_RPM: Per-IP requests per minute cap on AI generation endpoints (default: 30).
RATE_LIMIT_RPM="30"

# GEMINI_GENERATION_MODELS: Comma-separated ordered model cascade for /api/generate and /api/refine-slide.
GEMINI_GENERATION_MODELS="gemini-4-hydrogen,gemini-3.1-flash-lite,gemini-3.5-flash-lite"

# GEMINI_IMAGE_MODELS: Comma-separated ordered model cascade for /api/generate-image.
GEMINI_IMAGE_MODELS="gemini-3.1-flash-lite-image,gemini-nano-banana-2.1"

# OPTIONAL NEON POSTGRESQL CLOUD PERSISTENCE:
# Serverless PostgreSQL connection string (e.g. Neon, Supabase, Cloud SQL) for cross-device post sync and durable storage.
DATABASE_URL=""

# OPTIONAL VERCEL CLOUD PERSISTENCE (Vercel KV / Upstash Redis):
# Connect an Upstash Redis / Vercel KV store in your Vercel project to persist saved valid posts across all devices.
# Even without these variables, the app automatically persists validated posts via Browser IndexedDB + /tmp sync.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# CLOUDINARY STAGING & AUTO-CLEANUP:
# Used by /api/publish/upload-media and /api/publish/cleanup-media to stage slide JPEGs and delete them after publish.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# BUFFER FREE DEVELOPER API:
# Optional Buffer GraphQL API token (https://api.buffer.com) for 1-click publishing & queue scheduling (3 free channels).
BUFFER_API_KEY=""

# ZERNIO FREE API & MCP SERVER:
# Optional Zernio API key (https://zernio.com/api/v1 & https://mcp.zernio.com/mcp) for unlimited free TikTok & Instagram publishing (2 free accounts).
ZERNIO_API_KEY=""

# DIRECT TELEGRAM BOT WEBHOOK AUTOMATION (OPTIONAL):
# Used by POST /api/gather/telegram-webhook for mobile URL-to-Vault synthesis and inline Approve / Next Slot / Reject buttons.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ALLOWED_CHAT_IDS=""

